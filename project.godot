; Engine configuration file.
config_version=5

[application]

config/name="Relay Nine: BREACH"
config/description="Vertical Slice 0.1 - singleplayer tactical CQB"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/core/settings.gd"
MatLib="*res://scripts/core/matlib.gd"
Sfx="*res://scripts/core/sfx.gd"
Fx="*res://scripts/fx/fx.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="interact"
3d_physics/layer_6="audio_zones"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8

[rendering]

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/atlas_size=8192
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
